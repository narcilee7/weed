{
  "name": "weed",
  "private": true,
  "version": "0.0.0",
  "description": "Components that grow anywhere. A pi.dev-flavored shadcn/ui registry.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @weed/web dev",
    "build": "pnpm tokens:build && pnpm registry:build && pnpm -r build",
    "build:web": "pnpm --filter @weed/web build",
    "registry:build": "node registry/scripts/build.mjs",
    "tokens:build": "node packages/tokens/scripts/build-tokens.mjs",
    "tokens:check": "node packages/tokens/scripts/build-tokens.mjs --check",
    "check": "pnpm tokens:check",
    "preview": "pnpm --filter @weed/web preview"
  }
}
