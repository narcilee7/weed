{
  "$description": "weed design tokens — 单一事实源。DTCG 2025.10 格式。由 scripts/build-tokens.mjs 生成 CSS 变量、Tailwind v4 preset 与 tweakcn 主题导出。改这里，不要改生成物。",
  "$extensions": {
    "weed.cssVar": "每个 token 用 $cssVar 指定生成的 CSS 自定义属性名；未指定时按组约定推导。",
    "weed.alias": "{组.路径} 形式的引用，生成时解析为 var(--<目标 $cssVar>)。"
  },

  "color": {
    "$type": "color",
    "$description": "Tier 1 · 原料色（主题无关）与 Tier 2 · 语义色（双主题）。",

    "primitive": {
      "$description": "原料色。所有 oklch 值由锚点 hex 经 scripts/hex-to-oklch.mjs 换算，可追溯回设计稿。",
      "ink": {
        "950": { "$cssVar": "--w-ink-950", "$value": { "colorSpace": "oklch", "components": [0.156, 0.005, 67.4], "alpha": 1, "hex": "#0e0c0a" } },
        "900": { "$cssVar": "--w-ink-900", "$value": { "colorSpace": "oklch", "components": [0.179, 0.005, 67.5], "alpha": 1, "hex": "#13110f" } },
        "700": { "$cssVar": "--w-ink-700", "$value": { "colorSpace": "oklch", "components": [0.254, 0.012, 78], "alpha": 1, "hex": "#26221c" } },
        "500": { "$cssVar": "--w-ink-500", "$value": { "colorSpace": "oklch", "components": [0.517, 0.022, 80], "alpha": 1, "hex": "#6f675a" } }
      },
      "bone": {
        "100": { "$cssVar": "--w-bone-100", "$value": { "colorSpace": "oklch", "components": [0.951, 0.016, 82.8], "alpha": 1, "hex": "#f4eee3" } },
        "50": { "$cssVar": "--w-bone-50", "$value": { "colorSpace": "oklch", "components": [0.98, 0.01, 87.5], "alpha": 1, "hex": "#fbf8f1" } },
        "200": { "$cssVar": "--w-bone-200", "$value": { "colorSpace": "oklch", "components": [0.847, 0.028, 85.7], "alpha": 1, "hex": "#d5ccb9" } }
      },
      "slate": {
        "900": { "$cssVar": "--w-slate-900", "$value": { "colorSpace": "oklch", "components": [0.302, 0.029, 256.8], "alpha": 1, "hex": "#252f3d" } },
        "950": { "$cssVar": "--w-slate-950", "$value": { "colorSpace": "oklch", "components": [0.263, 0.023, 259.3], "alpha": 1, "hex": "#1e2530" } },
        "700": { "$cssVar": "--w-slate-700", "$value": { "colorSpace": "oklch", "components": [0.375, 0.027, 265.4], "alpha": 1, "hex": "#3a4150" } }
      },
      "blue": {
        "600": { "$cssVar": "--w-blue", "$value": { "colorSpace": "oklch", "components": [0.683, 0.087, 245.2], "alpha": 1, "hex": "#6a9fcc" } },
        "700": { "$cssVar": "--w-blue-deep", "$value": { "colorSpace": "oklch", "components": [0.528, 0.092, 248.6], "alpha": 1, "hex": "#3d6f9e" } }
      },
      "ochre": {
        "500": { "$cssVar": "--w-ochre", "$value": { "colorSpace": "oklch", "components": [0.68, 0.111, 62.3], "alpha": 1, "hex": "#c9884b" } },
        "600": { "$cssVar": "--w-ochre-deep", "$value": { "colorSpace": "oklch", "components": [0.582, 0.109, 60.4], "alpha": 1, "hex": "#a96a30" } }
      },
      "wheat": {
        "500": { "$cssVar": "--w-wheat", "$value": { "colorSpace": "oklch", "components": [0.775, 0.084, 78.8], "alpha": 1, "hex": "#d3b078" } },
        "600": { "$cssVar": "--w-wheat-deep", "$value": { "colorSpace": "oklch", "components": [0.571, 0.077, 81.2], "alpha": 1, "hex": "#8f7340" } }
      },
      "sage": {
        "500": { "$cssVar": "--w-sage", "$value": { "colorSpace": "oklch", "components": [0.705, 0.057, 131.9], "alpha": 1, "hex": "#93a883" } },
        "600": { "$cssVar": "--w-sage-deep", "$value": { "colorSpace": "oklch", "components": [0.528, 0.059, 134.2], "alpha": 1, "hex": "#5d7350" } }
      }
    },

    "semantic": {
      "$description": "Tier 2 · 语义色。dark 与 light 用同一组 CSS 变量名，靠 data-theme 切换。",

      "dark": {
        "background": { "$cssVar": "--background", "$value": { "colorSpace": "oklch", "components": [0.145, 0.004, 67.5], "alpha": 1, "hex": "#0b0a08" } },
        "foreground": { "$cssVar": "--foreground", "$value": { "colorSpace": "oklch", "components": [0.911, 0.013, 82.4], "alpha": 1, "hex": "#e6e1d8" } },
        "panel": { "$cssVar": "--panel", "$value": "{color.primitive.slate.950}" },
        "panelSoft": { "$cssVar": "--panel-soft", "$value": { "colorSpace": "oklch", "components": [0.205, 0.014, 255], "alpha": 1, "hex": "#13181e" } },
        "panelForeground": { "$cssVar": "--panel-foreground", "$value": "{color.semantic.dark.foreground}" },
        "card": { "$cssVar": "--card", "$value": "{color.semantic.dark.panel}" },
        "cardForeground": { "$cssVar": "--card-foreground", "$value": "{color.semantic.dark.foreground}" },
        "popover": { "$cssVar": "--popover", "$value": { "colorSpace": "oklch", "components": [0.225, 0.016, 255], "alpha": 1, "hex": "#171c23" } },
        "popoverForeground": { "$cssVar": "--popover-foreground", "$value": "{color.semantic.dark.foreground}" },
        "line": { "$cssVar": "--line", "$value": { "colorSpace": "oklch", "components": [0.31, 0.012, 252], "alpha": 1, "hex": "#2c3136" } },
        "lineStrong": { "$cssVar": "--line-strong", "$value": { "colorSpace": "oklch", "components": [0.395, 0.016, 252], "alpha": 1, "hex": "#40474f" } },
        "border": { "$cssVar": "--border", "$value": "{color.semantic.dark.line}" },
        "muted": { "$cssVar": "--muted", "$value": "{color.semantic.dark.panelSoft}" },
        "mutedForeground": { "$cssVar": "--muted-foreground", "$value": { "colorSpace": "oklch", "components": [0.62, 0.014, 82], "alpha": 1, "hex": "#8a857d" } },
        "primary": { "$cssVar": "--primary", "$value": "{color.primitive.blue.600}" },
        "primaryForeground": { "$cssVar": "--primary-foreground", "$value": { "colorSpace": "oklch", "components": [0.16, 0.012, 248.5], "alpha": 1, "hex": "#090e12" } },
        "accent": { "$cssVar": "--accent", "$value": "{color.semantic.dark.primary}" },
        "accentForeground": { "$cssVar": "--accent-foreground", "$value": "{color.semantic.dark.primaryForeground}" },
        "secondary": { "$cssVar": "--secondary", "$value": "{color.semantic.dark.panelSoft}" },
        "secondaryForeground": { "$cssVar": "--secondary-foreground", "$value": "{color.semantic.dark.foreground}" },
        "destructive": { "$cssVar": "--destructive", "$value": "{color.primitive.ochre.600}" },
        "destructiveForeground": { "$cssVar": "--destructive-foreground", "$value": "{color.primitive.bone.100}" },
        "input": { "$cssVar": "--input", "$value": "{color.semantic.dark.lineStrong}" },
        "ring": { "$cssVar": "--ring", "$value": "{color.primitive.blue.600}" },
        "ochre": { "$cssVar": "--ochre", "$value": "{color.primitive.ochre.500}" },
        "wheat": { "$cssVar": "--wheat", "$value": "{color.primitive.wheat.500}" },
        "sage": { "$cssVar": "--sage", "$value": "{color.primitive.sage.500}" }
      },

      "light": {
        "background": { "$cssVar": "--background", "$value": "{color.primitive.bone.100}" },
        "foreground": { "$cssVar": "--foreground", "$value": "{color.primitive.ink.700}" },
        "panel": { "$cssVar": "--panel", "$value": "{color.primitive.bone.50}" },
        "panelSoft": { "$cssVar": "--panel-soft", "$value": { "colorSpace": "oklch", "components": [0.962, 0.014, 88], "alpha": 1, "hex": "#f6f2e8" } },
        "panelForeground": { "$cssVar": "--panel-foreground", "$value": "{color.semantic.light.foreground}" },
        "card": { "$cssVar": "--card", "$value": "{color.semantic.light.panel}" },
        "cardForeground": { "$cssVar": "--card-foreground", "$value": "{color.semantic.light.foreground}" },
        "popover": { "$cssVar": "--popover", "$value": "{color.semantic.light.panel}" },
        "popoverForeground": { "$cssVar": "--popover-foreground", "$value": "{color.semantic.light.foreground}" },
        "line": { "$cssVar": "--line", "$value": { "colorSpace": "oklch", "components": [0.8, 0.02, 85.7], "alpha": 1, "hex": "#c3bdb0" } },
        "lineStrong": { "$cssVar": "--line-strong", "$value": { "colorSpace": "oklch", "components": [0.68, 0.025, 84.6], "alpha": 1, "hex": "#9f9787" } },
        "border": { "$cssVar": "--border", "$value": "{color.semantic.light.line}" },
        "muted": { "$cssVar": "--muted", "$value": "{color.primitive.bone.200}" },
        "mutedForeground": { "$cssVar": "--muted-foreground", "$value": "{color.primitive.ink.500}" },
        "primary": { "$cssVar": "--primary", "$value": "{color.primitive.blue.700}" },
        "primaryForeground": { "$cssVar": "--primary-foreground", "$value": "{color.primitive.bone.50}" },
        "accent": { "$cssVar": "--accent", "$value": "{color.semantic.light.primary}" },
        "accentForeground": { "$cssVar": "--accent-foreground", "$value": "{color.semantic.light.primaryForeground}" },
        "secondary": { "$cssVar": "--secondary", "$value": "{color.primitive.bone.200}" },
        "secondaryForeground": { "$cssVar": "--secondary-foreground", "$value": "{color.semantic.light.foreground}" },
        "destructive": { "$cssVar": "--destructive", "$value": "{color.primitive.ochre.600}" },
        "destructiveForeground": { "$cssVar": "--destructive-foreground", "$value": "{color.primitive.bone.50}" },
        "input": { "$cssVar": "--input", "$value": "{color.semantic.light.lineStrong}" },
        "ring": { "$cssVar": "--ring", "$value": "{color.primitive.blue.700}" },
        "ochre": { "$cssVar": "--ochre", "$value": "{color.primitive.ochre.600}" },
        "wheat": { "$cssVar": "--wheat", "$value": "{color.primitive.wheat.600}" },
        "sage": { "$cssVar": "--sage", "$value": "{color.primitive.sage.600}" }
      }
    },

    "component": {
      "$description": "Tier 3 · 组件层。语义变量的组合，主题无关（引用的是会随主题切换的语义变量）。",
      "button": {
        "bg": { "$cssVar": "--w-c-button-bg", "$value": "{color.semantic.dark.panel}" },
        "fg": { "$cssVar": "--w-c-button-fg", "$value": "{color.semantic.dark.foreground}" },
        "line": { "$cssVar": "--w-c-button-line", "$value": "{color.semantic.dark.lineStrong}" },
        "bgHover": { "$cssVar": "--w-c-button-bg-hover", "$value": "{color.semantic.dark.panelSoft}" },
        "primaryBg": { "$cssVar": "--w-c-button-primary-bg", "$value": "{color.semantic.dark.primary}" },
        "primaryFg": { "$cssVar": "--w-c-button-primary-fg", "$value": "{color.semantic.dark.primaryForeground}" }
      },
      "input": {
        "bg": { "$cssVar": "--w-c-input-bg", "$value": "{color.semantic.dark.background}" },
        "line": { "$cssVar": "--w-c-input-line", "$value": "{color.semantic.dark.lineStrong}" },
        "lineFocus": { "$cssVar": "--w-c-input-line-focus", "$value": "{color.semantic.dark.ring}" }
      },
      "badge": {
        "bg": { "$cssVar": "--w-c-badge-bg", "$value": "{color.semantic.dark.panelSoft}" },
        "fg": { "$cssVar": "--w-c-badge-fg", "$value": "{color.semantic.dark.mutedForeground}" },
        "line": { "$cssVar": "--w-c-badge-line", "$value": "{color.semantic.dark.line}" }
      },
      "code": {
        "bg": { "$cssVar": "--w-c-code-bg", "$value": { "colorSpace": "oklch", "components": [0.185, 0.012, 252], "alpha": 1, "hex": "#0f1318" } },
        "fg": { "$cssVar": "--w-c-code-fg", "$value": "{color.primitive.wheat.500}" }
      },
      "chrome": {
        "bg": { "$cssVar": "--w-c-chrome", "$value": { "colorSpace": "oklch", "components": [0.205, 0.014, 255], "alpha": 1, "hex": "#13181e" } },
        "fg": { "$cssVar": "--w-c-chrome-fg", "$value": "{color.semantic.dark.mutedForeground}" }
      },
      "prompt": { "$cssVar": "--w-c-prompt", "$value": "{color.semantic.dark.sage}" },
      "caret": { "$cssVar": "--w-c-caret", "$value": "{color.semantic.dark.primary}" }
    }
  },

  "css": {
    "$type": "string",
    "$description": "无法用 DTCG 类型表达的复合 CSS 值（color-mix / gradient / font stack / shadow）。",

    "schemeDark": { "$cssVar": "--color-scheme", "$value": "dark" },
    "schemeLight": { "$cssVar": "--color-scheme", "$value": "light" },

    "gridMinorDark": { "$cssVar": "--grid-minor", "$value": "color-mix(in oklab, var(--foreground) 3%, transparent)" },
    "gridMajorDark": { "$cssVar": "--grid-major", "$value": "color-mix(in oklab, var(--foreground) 6%, transparent)" },
    "gridDotDark": { "$cssVar": "--grid-dot", "$value": "color-mix(in oklab, var(--w-blue) 22%, transparent)" },
    "gridFadeDark": { "$cssVar": "--grid-fade", "$value": "radial-gradient(ellipse 120% 80% at 50% 0%, black 0%, black 28%, transparent 72%)" },

    "gridMinorLight": { "$cssVar": "--grid-minor", "$value": "color-mix(in oklab, var(--foreground) 4%, transparent)" },
    "gridMajorLight": { "$cssVar": "--grid-major", "$value": "color-mix(in oklab, var(--foreground) 8%, transparent)" },
    "gridDotLight": { "$cssVar": "--grid-dot", "$value": "color-mix(in oklab, var(--w-blue-deep) 20%, transparent)" },

    "selection": { "$cssVar": "--w-c-selection", "$value": "color-mix(in oklab, var(--primary) 28%, transparent)" },

    "hairline": { "$cssVar": "--w-hairline", "$value": "0 0 0 1px var(--line)" },
    "hairlineStrong": { "$cssVar": "--w-hairline-strong", "$value": "0 0 0 1px var(--line-strong)" },

    "fontMono": { "$cssVar": "--w-font-mono", "$value": "\"Departure Mono\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", ui-monospace, SFMono-Regular, Menlo, monospace" },
    "fontSerif": { "$cssVar": "--w-font-serif", "$value": "\"Source Serif 4\", Georgia, \"Times New Roman\", \"PingFang SC\", \"Noto Sans CJK SC\", serif" }
  },

  "dimension": {
    "$type": "dimension",
    "$description": "尺度。字体尺寸按终端 / IDE 的紧凑尺度给；radius 到 3px 为止。",

    "text": {
      "xs": { "$cssVar": "--w-text-xs", "$value": { "value": 10.5, "unit": "px" } },
      "sm": { "$cssVar": "--w-text-sm", "$value": { "value": 12, "unit": "px" } },
      "base": { "$cssVar": "--w-text-base", "$value": { "value": 13.5, "unit": "px" } },
      "lg": { "$cssVar": "--w-text-lg", "$value": { "value": 17, "unit": "px" } },
      "xl": { "$cssVar": "--w-text-xl", "$value": { "value": 26, "unit": "px" } },
      "2xl": { "$cssVar": "--w-text-2xl", "$value": { "value": 38, "unit": "px" } }
    },
    "radius": {
      "default": { "$cssVar": "--w-radius", "$value": { "value": 3, "unit": "px" } },
      "sm": { "$cssVar": "--w-radius-sm", "$value": { "value": 2, "unit": "px" } }
    },
    "tracking": {
      "label": { "$cssVar": "--w-tracking-label", "$value": { "value": 0.1, "unit": "em" } }
    },
    "leading": {
      "prose": { "$cssVar": "--w-leading-prose", "$value": { "value": 1.65, "unit": "" } },
      "ui": { "$cssVar": "--w-leading-ui", "$value": { "value": 1.45, "unit": "" } }
    }
  },

  "tailwind": {
    "$type": "string",
    "$description": "Tailwind v4 `@theme inline` 映射。颜色全部指向语义变量，data-theme 切换零配置。",

    "background": { "$cssVar": "--color-background", "$value": "var(--background)" },
    "foreground": { "$cssVar": "--color-foreground", "$value": "var(--foreground)" },
    "card": { "$cssVar": "--color-card", "$value": "var(--card)" },
    "cardForeground": { "$cssVar": "--color-card-foreground", "$value": "var(--card-foreground)" },
    "popover": { "$cssVar": "--color-popover", "$value": "var(--popover)" },
    "popoverForeground": { "$cssVar": "--color-popover-foreground", "$value": "var(--popover-foreground)" },
    "primary": { "$cssVar": "--color-primary", "$value": "var(--primary)" },
    "primaryForeground": { "$cssVar": "--color-primary-foreground", "$value": "var(--primary-foreground)" },
    "secondary": { "$cssVar": "--color-secondary", "$value": "var(--secondary)" },
    "secondaryForeground": { "$cssVar": "--color-secondary-foreground", "$value": "var(--secondary-foreground)" },
    "muted": { "$cssVar": "--color-muted", "$value": "var(--muted)" },
    "mutedForeground": { "$cssVar": "--color-muted-foreground", "$value": "var(--muted-foreground)" },
    "accent": { "$cssVar": "--color-accent", "$value": "var(--accent)" },
    "accentForeground": { "$cssVar": "--color-accent-foreground", "$value": "var(--accent-foreground)" },
    "destructive": { "$cssVar": "--color-destructive", "$value": "var(--destructive)" },
    "destructiveForeground": { "$cssVar": "--color-destructive-foreground", "$value": "var(--destructive-foreground)" },
    "border": { "$cssVar": "--color-border", "$value": "var(--border)" },
    "input": { "$cssVar": "--color-input", "$value": "var(--input)" },
    "ring": { "$cssVar": "--color-ring", "$value": "var(--ring)" },

    "panel": { "$cssVar": "--color-panel", "$value": "var(--panel)" },
    "panelSoft": { "$cssVar": "--color-panel-soft", "$value": "var(--panel-soft)" },
    "panelForeground": { "$cssVar": "--color-panel-foreground", "$value": "var(--panel-foreground)" },
    "line": { "$cssVar": "--color-line", "$value": "var(--line)" },
    "lineStrong": { "$cssVar": "--color-line-strong", "$value": "var(--line-strong)" },
    "ochre": { "$cssVar": "--color-ochre", "$value": "var(--ochre)" },
    "wheat": { "$cssVar": "--color-wheat", "$value": "var(--wheat)" },
    "sage": { "$cssVar": "--color-sage", "$value": "var(--sage)" },

    "fontMono": { "$cssVar": "--font-mono", "$value": "var(--w-font-mono)" },
    "fontSerif": { "$cssVar": "--font-serif", "$value": "var(--w-font-serif)" },

    "radiusSm": { "$cssVar": "--radius-sm", "$value": "var(--w-radius-sm)" },
    "radiusMd": { "$cssVar": "--radius-md", "$value": "var(--w-radius)" },
    "radiusLg": { "$cssVar": "--radius-lg", "$value": "calc(var(--w-radius) + 2px)" }
  },

  "theme": {
    "$type": "string",
    "$description": "tweakcn 兼容导出（shadcn 标准名 → 语义变量）。",

    "dark": {
      "background": { "$value": "{color.semantic.dark.background}" },
      "foreground": { "$value": "{color.semantic.dark.foreground}" },
      "card": { "$value": "{color.semantic.dark.card}" },
      "card-foreground": { "$value": "{color.semantic.dark.cardForeground}" },
      "popover": { "$value": "{color.semantic.dark.popover}" },
      "popover-foreground": { "$value": "{color.semantic.dark.popoverForeground}" },
      "primary": { "$value": "{color.semantic.dark.primary}" },
      "primary-foreground": { "$value": "{color.semantic.dark.primaryForeground}" },
      "secondary": { "$value": "{color.semantic.dark.secondary}" },
      "secondary-foreground": { "$value": "{color.semantic.dark.secondaryForeground}" },
      "muted": { "$value": "{color.semantic.dark.muted}" },
      "muted-foreground": { "$value": "{color.semantic.dark.mutedForeground}" },
      "accent": { "$value": "{color.semantic.dark.accent}" },
      "accent-foreground": { "$value": "{color.semantic.dark.accentForeground}" },
      "destructive": { "$value": "{color.semantic.dark.destructive}" },
      "destructive-foreground": { "$value": "{color.semantic.dark.destructiveForeground}" },
      "border": { "$value": "{color.semantic.dark.border}" },
      "input": { "$value": "{color.semantic.dark.input}" },
      "ring": { "$value": "{color.semantic.dark.ring}" }
    },
    "light": {
      "background": { "$value": "{color.semantic.light.background}" },
      "foreground": { "$value": "{color.semantic.light.foreground}" },
      "card": { "$value": "{color.semantic.light.card}" },
      "card-foreground": { "$value": "{color.semantic.light.cardForeground}" },
      "popover": { "$value": "{color.semantic.light.popover}" },
      "popover-foreground": { "$value": "{color.semantic.light.popoverForeground}" },
      "primary": { "$value": "{color.semantic.light.primary}" },
      "primary-foreground": { "$value": "{color.semantic.light.primaryForeground}" },
      "secondary": { "$value": "{color.semantic.light.secondary}" },
      "secondary-foreground": { "$value": "{color.semantic.light.secondaryForeground}" },
      "muted": { "$value": "{color.semantic.light.muted}" },
      "muted-foreground": { "$value": "{color.semantic.light.mutedForeground}" },
      "accent": { "$value": "{color.semantic.light.accent}" },
      "accent-foreground": { "$value": "{color.semantic.light.accentForeground}" },
      "destructive": { "$value": "{color.semantic.light.destructive}" },
      "destructive-foreground": { "$value": "{color.semantic.light.destructiveForeground}" },
      "border": { "$value": "{color.semantic.light.border}" },
      "input": { "$value": "{color.semantic.light.input}" },
      "ring": { "$value": "{color.semantic.light.ring}" }
    },
    "meta": {
      "dark": {
        "name": { "$value": "weed-dark" },
        "label": { "$value": "weed · dark (warm black)" }
      },
      "light": {
        "name": { "$value": "weed-light" },
        "label": { "$value": "weed · light (parchment)" }
      }
    }
  }
}
