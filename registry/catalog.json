{
  "$description": "weed 组件目录 —— 单一事实源。站点文档、registry 元数据、agent 索引全部从这里读。新增组件先改这里。",
  "items": [
    {
      "slug": "button",
      "title": "Button",
      "summary": "触发一次动作。终端里最常见的动词。",
      "description": "mono 大写、3px 圆角、实心面板 + 内描边。default 是 accent 实心，outline 是描边面板，ghost/subtle 无边框。",
      "category": "Actions",
      "status": "stable",
      "alsoCalled": ["CTA", "动作按钮"],
      "whenToUse": [
        "提交表单、触发下载、确认删除——任何有副作用的动作。",
        "一个视图里只能有一个 default 变体，其余都是 outline 或 ghost。"
      ],
      "insteadOf": [
        ["页面跳转（链接应该像链接）", "用 <a>，别用 Button 装 href"],
        ["开关某项设置", "用 Switch / Checkbox，别用 Button 假装成开关"]
      ],
      "anatomy": ["Button", "buttonVariants"],
      "variants": [
        { "name": "default", "description": "accent 实心，主操作" },
        { "name": "outline", "description": "实心面板 + 内描边，次操作" },
        { "name": "ghost", "description": "无边框，悬停才显形" },
        { "name": "subtle", "description": "浅底填充，表格行内操作用" }
      ],
      "npmDeps": ["class-variance-authority"],
      "api": [
        { "prop": "variant", "type": "\"default\" | \"outline\" | \"ghost\" | \"subtle\"", "default": "\"outline\"" },
        { "prop": "size", "type": "\"sm\" | \"default\" | \"lg\" | \"icon\"", "default": "\"default\"" },
        { "prop": "disabled", "type": "boolean", "default": "false" }
      ]
    },
