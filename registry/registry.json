{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "weed-ui",
  "homepage": "https://narcilee7.github.io/weed",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "weed theme",
      "description": "weed design language: OKLCH tokens (dark/light), terminal / IDE type stack, blueprint grid, 1px inset hairlines. Import the css files into your global stylesheet.",
      "files": [
        {
          "path": "packages/tokens/src/tokens.css",
          "target": "styles/weed-ui/tokens.css",
          "type": "registry:theme"
        },
        {
          "path": "packages/tokens/src/fonts.css",
          "target": "styles/weed-ui/fonts.css",
          "type": "registry:theme"
        },
        {
          "path": "packages/tokens/src/blueprint.css",
          "target": "styles/weed-ui/blueprint.css",
          "type": "registry:theme"
        },
        {
          "path": "packages/tokens/src/tailwind.css",
          "target": "styles/weed-ui/tailwind.css",
          "type": "registry:theme"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn() helper",
      "description": "clsx + tailwind-merge.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
